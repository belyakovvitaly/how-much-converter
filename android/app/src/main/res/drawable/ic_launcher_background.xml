<?xml version="1.0" encoding="utf-8"?>
<!--
  The blues of the picture's own edge, light at the top and deep at the bottom,
  across the middle 72 of the 108 canvas where the picture sits. It shows only
  where the picture's rounded corners are cut away and a launcher's mask is
  squarer than they are.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90">
                <item android:offset="0" android:color="#FF80CAF2" />
                <item android:offset="0.5" android:color="#FF3E6CC0" />
                <item android:offset="1" android:color="#FF364CB1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
